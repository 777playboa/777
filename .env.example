# Supabase Integration (PostgreSQL License & HWID storage)
# When set, licenses are loaded from and synced directly to Supabase table (default: client777_licenses)
SUPABASE_URL=https://vqrjzqlbshqvminngovb.supabase.co
SUPABASE_KEY=your_supabase_service_role_key_here
SUPABASE_TABLE=client777_licenses

PORT=8000
TRUSTED_PROXY_IPS=127.0.0.1,::1
DOMAIN=assets-delivery.site
SERVER_SECRET=
ADMIN_KEY=
# Dedicated website-to-auth license synchronization credential.
# Use the exact same random 64+ character value in /root/website/.env.
WEBSITE_SYNC_TOKEN=
SESSION_DURATION_HOURS=24
IDLE_SESSION_TIMEOUT_MINUTES=15
# Production default is persist-on. pm2 restart must not wipe in-game clients.
# Set false only for local tests that want restart-as-logout.
PERSIST_SESSIONS=true
# Shown to clients that run an unapproved release hash.
CLIENT_UPDATE_URL=https://assets-delivery.site/download
CURRENT_RELEASE_VERSION=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=https://assets-delivery.site/v1/auth/discord/callback
# Webhook = channel alerts from auth-server (login, logout, cracks, client errors).
# Client errors and security reports ping @everyone in that channel.
DISCORD_WEBHOOK=https://discord.com/api/webhooks/YOUR_ID/YOUR_TOKEN
# Bot token = Developer Portal → Bot → Reset Token (three dot-separated parts)
DISCORD_TOKEN=
# Alert channel (Developer Mode on → right-click channel → Copy Channel ID)
DISCORD_ALERT_CHANNEL_ID=
# Optional: ping this role instead of @everyone (more reliable). Right-click role → Copy Role ID.
DISCORD_PING_ROLE_ID=
# Auth-server → dragonite-bot local alert bridge (default 8001)
ALERT_BRIDGE_PORT=8001
ALERT_BRIDGE_RETRIES=4
INTERNAL_ALERT_SECRET=
# Set true only if you want webhook when the bot bridge fails (default: bot only)
DISCORD_ALERT_USE_WEBHOOK=false
AUTH_SERVER_URL=http://127.0.0.1:8000
NODE_ENV=production
DRAGONITE_PRODUCTION=true
# Leave false until event IDs are server-issued and checked after auth proof.
ENABLE_EVENT_ID_HONEYTRAP=false
ACDETECT_ENCRYPTION_KEY=
# Echo-style stub loader: license session + AES-GCM payload stream.
# Must be explicitly true — omitted/false disables /v1/stub/session and /v1/payload.
ALLOW_STUB_LOADER=true
# Path to the registered release client JAR streamed after stub auth (AES-GCM).
# Example: /root/dragonite/payload/client.jar
DRAGONITE_PAYLOAD_PATH=
# Keep false in production. true = allow stub session when stub HWID ≠ license HWID
# (leaks the client JAR to any PC that knows the license key).
ALLOW_STUB_HWID_RELAX=false

# Production requires at least one approved JAR SHA-256. Set false only for
# short-lived local testing while EXPECTED_JAR_HASHES is intentionally empty.
ENFORCE_JAR_HASH=true
# Production: setting ENFORCE_JAR_HASH=false requires ALLOW_DISABLE_JAR_HASH=emergency
# ALLOW_DISABLE_JAR_HASH=
EXPECTED_JAR_HASHES=
MAX_LICENSE_FAILURES=5
LICENSE_FAILURE_WINDOW_MS=900000
# Ed25519 public key (SPKI base64) — set ONCE from obfuscator native/master_ed25519_spki.b64
ED25519_PUBLIC_KEY_SPKI_B64=
ECDSA_PUBLIC_KEY_SPKI_B64=
# Legacy client proof is disabled; production requires nonce-bound hmac2 proofs.
REQUIRE_AUTH_PROOF=true
# Must match native/master_ikm.hex from the same release build (64 hex chars).
NATIVE_IKM_HEX=
# Never set in production.
# ALLOW_UNVERIFIED_PROOFS=false
# Generated and kept only on the VPS. The public half is embedded in the client.
AUTH_RESPONSE_ED25519_PRIVATE_PKCS8_B64=
# warn = log IP mismatch; strict = revoke session on IP change
SESSION_IP_BIND_MODE=warn
APPEAL_DISCORD_URL=https://discord.gg/2VB9jgufWC

# /download: Customer, Customer+, Media (by role name) plus these IDs. OP = owner or Administrator.
# Replace the jar file (or this path) to change what /download attaches — users get no version picker.
DISCORD_CUSTOMER_ROLE_ID=
DISCORD_CUSTOMER_PLUS_ROLE_ID=
DISCORD_PREMIUM_ROLE_ID=
DISCORD_MEDIA_ROLE_ID=
DISCORD_OP_ROLE_ID=
DISCORD_DOWNLOAD_ALLOWED_ROLE_IDS=
DISCORD_DOWNLOAD_JAR=/root/private/vertex-spatial-model-2.2.13.jar
